# Neon の接続文字列（プーラーを通さない直接の接続。sslmode=verify-full にする）。このファイルを .env にコピーして値を入れる
DATABASE_URL=

# Better Auth がセッションの署名などに使う秘密の値（32 文字以上のランダムな文字列）。`openssl rand -base64 32` などで作る
BETTER_AUTH_SECRET=
# server の URL（省略すると http://localhost:3001）
BETTER_AUTH_URL=http://localhost:3001
# web の origin。server はこの origin からの cookie 付きの呼び出しを受け付ける（省略すると http://localhost:3000）
WEB_ORIGIN=http://localhost:3000

# ---- web（apps/web）----
# web はルートの .env を読まない。既定値と違う URL にするときは、apps/web/.env.local に書くか、起動時に指定する
# server の URL（web の server 側から呼ぶとき。省略すると http://localhost:3001）
# SERVER_URL=http://localhost:3001
# server の URL（ブラウザから呼ぶとき。ビルド時に埋め込まれる。省略すると http://localhost:3001）
# NEXT_PUBLIC_SERVER_URL=http://localhost:3001
