	},
	"devDependencies": {
		"@swc/core": "^1.16.18",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "^24.19.2",
		"jest": "30.5.2",
		"tsup": "^8.5.1",
		"tsx": "4.23.15"
