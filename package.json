{
	"name": "chat-app",
	"private": true,
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter \"./apps/*\" dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"test": "pnpm -r test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"typescript": "~6.0.3"
	}
}
